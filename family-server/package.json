{
  "name": "levelup-family",
  "private": true,
  "version": "1.0.0",
  "description": "LEVEL UP family link: a small Cloudflare Worker + Durable Object relay and the parent web app",
  "type": "module",
  "scripts": {
    "assets": "sh scripts/sync-assets.sh",
    "dev": "sh scripts/sync-assets.sh && wrangler dev --local",
